    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Setup Script",
            "type": "bashdb",
            "request": "launch",
            "program": "${workspaceFolder}/setup.sh",
            "args": [
                "--no_win"
            ],
            "cwd": "${workspaceFolder}",
            "terminalKind": "integrated",
            "presentation": {
                "hidden": false,
                "group": "Setup",
                "order": 3
            }
        },
        {
            "name": "Debug Launch Script (Linux)",
            "type": "bashdb",
            "request": "launch",
            "program": "${workspaceFolder}/launch.sh",
            "args": ["--linux"],
            "cwd": "${workspaceFolder}",
            "terminalKind": "integrated",
            "presentation": {
                "hidden": false,
                "group": "Setup",
                "order": 3
            }
        },
        {
            "name": "Debug Launch Script (Win)",
            "type": "bashdb",
            "request": "launch",
            "program": "${workspaceFolder}/launch.sh",
            "args": ["--windows"],
            "cwd": "${workspaceFolder}",
            "terminalKind": "integrated",
            "presentation": {
                "hidden": false,
                "group": "Setup",
                "order": 3
            }
        },
        {
            "name": "Setup and Launch App Linux",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/x64-linux/QuestiMakinator",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "setup-and-build-release",
            "internalConsoleOptions": "openOnSessionStart",
            "presentation": {
                "hidden": false,
                "group": "Setup",
                "order": 3
            }
        },
        {
            "name": "Setup and Launch App Linux Debug",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/x64-linux/QuestiMakinator",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "setup-and-build-debug",
            "internalConsoleOptions": "openOnSessionStart",
            "presentation": {
                "hidden": false,
                "group": "Setup",
                "order": 3
            }
        },
        {
            "name": "Debug Pack script",
            "type": "bashdb",
            "request": "launch",
            "program": "${workspaceFolder}/pack.sh",
            "args": [
                "--linux",
                "--dynamic",
                "--pack"
            ],
            "cwd": "${workspaceFolder}",
            "terminalKind": "integrated",
            "presentation": {
                "hidden": false,
                "group": "Setup",
                "order": 3
            }
        },
        {
            "name": "Debug program",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/x64-linux/QuestiMakinator",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug-linux-no-config",
            "internalConsoleOptions": "openOnSessionStart",
            "presentation": {
                "hidden": false,
                "group": "Debug Linux",
                "order": 2
            }
        },
        {
            "name": "Debug program (Linux Dynamic)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/x64-linux-dynamic/QuestiMakinator",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "LIBGL_ALWAYS_SOFTWARE": "1",
                "WAYLAND_DISPLAY": "",
                "DISPLAY": ":0"
            },
            "internalConsoleOptions": "openOnSessionStart",
            "presentation": {
                "hidden": false,
                "group": "Debug Linux",
                "order": 3
            }
        },
        {
            "name": "Debug program with args",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/x64-linux/QuestiMakinator",
            "args": [
                "-m",
                // "-l",
                // "en_us", //parcial name
                // "pt_br.snbt"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug-linux-no-config",
            "internalConsoleOptions": "openOnSessionStart",
            "presentation": {
                "hidden": false,
                "group": "Debug Linux",
                "order": 2
            }
        },
        {
            "name": "Debug program (Win)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/x64-mingw-static/QuestiMakinator.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug-windows-no-config",
            "internalConsoleOptions": "openOnSessionStart",
            "presentation": {
                "hidden": false,
                "group": "Debug Windows",
                "order": 1
            }
        },
        {
            "name": "Licences",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/licences.py",
            "console": "integratedTerminal",
            "args": ["--no_print"],
            "presentation": {
                "hidden": false,
                "group": "Setup",
                "order": 3
            }
        }
    ],
    "compounds": [
        {
            "name": "setup-and-build-release",
            "configurations": ["Setup and Launch App Linux"],
            "preLaunchTask": "${workspaceFolder}/.vscode/tasks:setup-project && ${workspaceFolder}/.vscode/tasks:build-release-linux",
            "presentation": {
                "hidden": true,
                "group": "",
                "order": 1
            }
        },
        {
            "name": "setup-and-build-debug",
            "configurations": ["Setup and Launch App Linux Debug"],
            "preLaunchTask": "${workspaceFolder}/.vscode/tasks:setup-project && ${workspaceFolder}/.vscode/tasks:build-debug-linux",
            "presentation": {
                "hidden": true,
                "group": "",
                "order": 1
            }
        }
    ]
}